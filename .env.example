# Core Telegram and database configuration
BOT_TOKEN=123456:replace-me
WEBHOOK_BASE_URL=https://your-service.run.app
WEBHOOK_PATH_SECRET=replace-with-a-long-random-path
WEBHOOK_HEADER_SECRET=replace-with-a-long-random-header-secret
SCHEDULER_SECRET=replace-with-a-long-random-scheduler-secret
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres
DEFAULT_TIMEZONE=Europe/Kyiv
OWNER_TELEGRAM_ID=123456789

# Production runtime identity
ENVIRONMENT=development
BUILD_SHA=local
CLOUD_RUN_REVISION=
TRUST_PROXY_HEADERS=false

# Redis is optional locally. Production requires REDIS_REQUIRED=true and rediss:// TLS.
REDIS_URL=
REDIS_REQUIRED=false
REDIS_KEY_PREFIX=chatpulse:v1
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=20

# Webhook protection. The upper bound is exactly 512 KiB.
WEBHOOK_MAX_BODY_BYTES=524288
WEBHOOK_MAX_CONCURRENCY=20

# Protected Prometheus and diagnostics endpoints
METRICS_ENABLED=false
INTERNAL_METRICS_TOKEN=replace-with-at-least-16-random-characters

# Optional privacy-safe Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.05

# PostgreSQL pool and query limits
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=500
DB_DISABLE_PREPARED_STATEMENTS=false
